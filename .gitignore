# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build
dist

# turbo
.turbo

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env*.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma CLI config must stay as prisma.config.ts (compiled CJS breaks `prisma generate`)
apps/api/prisma.config.js
apps/api/prisma.config.js.map
apps/api/prisma.config.d.ts

# Accidental tsc emit next to seed/scripts (run via tsx, not Nest build)
apps/api/prisma/seed.js
apps/api/prisma/seed.js.map
apps/api/prisma/seed.d.ts
apps/api/scripts/*.js
apps/api/scripts/*.js.map
apps/api/scripts/*.d.ts
!apps/api/scripts/*.mjs

# Playwright
playwright-report/
test-results/

# Local uploads / temp
tmp/
uploads/

.vscode/*
