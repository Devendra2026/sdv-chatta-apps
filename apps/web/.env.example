# Citizen web dev server runs on port 3001.
# Leave NEXT_PUBLIC_API_URL empty so the browser uses same-origin /api rewrites (recommended).
# NEXT_PUBLIC_API_URL=
#
# Server-side rewrite target (Next → Nest). Required in Docker; defaults to http://localhost:4000 locally.
API_INTERNAL_URL=http://localhost:4000
#
# Payment return URL is configured on the API (ATOM_RETURN_URL), not here:
#   http://localhost:3001/propertytax/payment/return
