PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://chhata:chhata@localhost:5433/chhata?schema=public
REDIS_URL=redis://localhost:6380
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chhata-surveys
# Comma-separated. Include portal (:3000) and citizen web (:3001).
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Must be the public portal origin (OAuth callbacks go through portal /api rewrite).
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
API_URL=http://localhost:4000
# Google OAuth (optional in local; required for "Continue with Google").
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seed admin (used by prisma seed). Never commit real passwords.
SEED_ADMIN_EMAIL=sikarwar2010@gmail.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=change-me-seed-admin-password
PAYMENT_PROVIDER=sandbox
ATOM_BASE_URL=https://paynetzuat.atomtech.in
# Citizen web return (apps/web). Callback stays on API.
ATOM_RETURN_URL=http://localhost:3001/propertytax/payment/return
ATOM_CALLBACK_URL=http://localhost:4000/api/v1/payments/gateway/callback
# Atom UAT (leave empty for sandbox). Never commit real production secrets.
ATOM_MERCH_ID=
ATOM_PASSWORD=
ATOM_API_SECRET_KEY=
ATOM_AES_REQUEST_KEY=
ATOM_AES_REQUEST_IV=
ATOM_AES_RESPONSE_KEY=
ATOM_AES_RESPONSE_IV=
ATOM_PRODUCT=NSE
IMPORT_MAX_FILE_SIZE_MB=50
