{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "ts-jest",
      {
        "tsconfig": {
          "module": "commonjs",
          "esModuleInterop": true
        },
        "useESM": false
      }
    ]
  },
  "moduleNameMapper": {
    "^better-auth/node$": "<rootDir>/mocks/better-auth-node.ts",
    "^better-auth/adapters/prisma$": "<rootDir>/mocks/better-auth-prisma.ts",
    "^better-auth$": "<rootDir>/mocks/better-auth.ts",
    "^better-auth/crypto$": "<rootDir>/mocks/better-auth-crypto.ts"
  }
}
