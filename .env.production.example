# Paste this into Dokploy → Compose → Environment.
# Dokploy writes it as `.env` beside docker-compose.prod.yml.
# Replace every CHANGE_ME / example host. Do not commit real secrets.
#
# Do not set DATABASE_URL, REDIS_URL, CORS_ORIGIN, PUBLIC_APP_URL,
# ATOM_RETURN_URL, ATOM_CALLBACK_URL, or API_INTERNAL_URL here —
# docker-compose.prod.yml derives them from the values below.
# Portal/web reach Nest at http://chhata-api:4000 (unique Compose alias).
#
# Passwords for POSTGRES_PASSWORD and REDIS_PASSWORD must not contain
# @ : / # ? (they are interpolated into connection URLs).

NODE_ENV=production

# Public HTTPS origins (no trailing slash). Map these in Dokploy Domains.
# PUBLIC_WEB_URL is the Atom-registered citizen site. Do not point callbacks at the portal.
PUBLIC_WEB_URL=https://www.npchhata.com
PUBLIC_PORTAL_URL=https://portal.example.com

# Postgres (internal Docker DNS: postgres:5432)
POSTGRES_USER=chhata
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=chhata

# Redis (internal Docker DNS: redis:6379)
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# Auth — REQUIRED. If missing, Docker prints:
#   warning: The "SESSION_SECRET" variable is not set. Defaulting to a blank string.
# and the API container exits before the health check passes.
# Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_at_least_32_random_chars
# Session cookie + lifetime. Use chhata_session locally and in production
# (Secure is set automatically when PUBLIC_APP_URL is https).
SESSION_COOKIE_NAME=chhata_session
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=604800
# Argon2id password hashing.
ARGON2_MEMORY_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# CSRF double-submit cookie for authenticated mutating requests.
CSRF_COOKIE_NAME=csrf_token

# Super Admin seed — required. The API container runs this on every start
# (idempotent: upserts the same email, does not create duplicates).
# SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD are accepted as aliases.
# Never put a real production password in git.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

REQUEST_BODY_LIMIT=25mb
IMPORT_MAX_FILE_SIZE_MB=50

# Payments — production Atom AIPay (NTT Data).
# API startup fails if PAYMENT_PROVIDER is unset/sandbox, if a required
# secret below is blank, or if an AES field is not 32 hex characters.
# These values are not interchangeable. Do not copy one field into another.
#
# AES-CBC IV is fixed bytes 0..15 in the API. ATOM_AES_REQUEST_IV and
# ATOM_AES_RESPONSE_IV are the 32-hex merchant strings. The kit uses each
# string as both the PBKDF2 password and the PBKDF2 salt.
# Set ATOM_AES_REQUEST_KEY / ATOM_AES_RESPONSE_KEY only when NTT issued a
# different key. Do not invent them from the password or hash keys.
# ATOM_API_SECRET_KEY is not used by this protocol. Leave it unset.
# ATOM_PASSWORD is the transaction password. Hash keys sign and verify.
# payDetails.product is ProductID when set, otherwise ATOM_PRODUCT.
# When ATOM_SUB_CHANNEL is unset, production uses UP (UPI only).
# When ATOM_REFUND_URL is unset, production uses the refund host below.
# A different refund host still fails startup.
#
# Leave ATOM_RETURN_URL / ATOM_CALLBACK_URL unset. docker-compose.prod.yml
# derives them from PUBLIC_WEB_URL (citizen website, not portal):
#   ATOM_RETURN_URL   = ${PUBLIC_WEB_URL}/propertytax/payment/return
#   ATOM_CALLBACK_URL = ${PUBLIC_WEB_URL}/api/v1/payments/gateway/callback
#   browser return    = ${PUBLIC_WEB_URL}/api/v1/payments/gateway/return
#
# Dokploy go-live checklist:
# 1. PUBLIC_WEB_URL=https://www.npchhata.com and a real PUBLIC_PORTAL_URL
#    (HTTPS, no trailing slash).
# 2. Paste live NTT credentials into the empty fields below.
#    Merchant id is entered only in Dokploy (ATOM_MERCH_ID).
# 3. Confirm Atom has allowlisted the three website URLs above, product
#    NAGAR, UPI, and merchant category 9311. MCC is not sent on the auth API.
# 4. Refunds use ATOM_REFUND_URL (payment.atomtech.in), not the auth host.
PAYMENT_PROVIDER=atom
ATOM_BASE_URL=https://payment1.atomtech.in
ATOM_AUTH_URL=https://payment1.atomtech.in/ots/aipay/auth
ATOM_CHECKOUT_CDN=https://psa.atomtech.in/staticdata/ots/js/atomcheckout.js
ATOM_CHECKOUT_ENV=prod
ATOM_REFUND_URL=https://payment.atomtech.in/ots/payment/refund
ATOM_MERCH_ID=
ATOM_PASSWORD=
ATOM_AES_REQUEST_IV=
ATOM_AES_RESPONSE_IV=
ATOM_REQ_HASH_KEY=
ATOM_RESP_HASH_KEY=
ATOM_PRODUCT=NSE
ProductID=NAGAR
ATOM_CUST_ACC_NO=
ATOM_SUB_CHANNEL=UP
