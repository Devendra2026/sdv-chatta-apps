# Shared / local development
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://chhata:chhata@localhost:5433/chhata?schema=public

# Redis (BullMQ jobs) — host 6380 avoids conflict with other local Redis on 6379
REDIS_URL=redis://localhost:6380

# MinIO — host 9010/9011 avoid conflict with other local MinIO on 9000/9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chhata-surveys
MINIO_PUBLIC_URL=http://localhost:9010
MINIO_CONSOLE_URL=http://localhost:9011

# NestJS API
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Public portal URL — cookies via same-origin /api rewrite
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000
REQUEST_BODY_LIMIT=25mb
IMPORT_MAX_FILE_SIZE_MB=50
SEED_ADMIN_EMAIL=sikarwar2010@gmail.com

# Portal (Next.js) — leave NEXT_PUBLIC_API_URL empty to use /api rewrite
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Atom NDPS / OTS payment gateway (server-only — never NEXT_PUBLIC_*)
PAYMENT_PROVIDER=sandbox
ATOM_BASE_URL=https://paynetzuat.atomtech.in
ATOM_MERCH_ID=
ATOM_PASSWORD=
ATOM_API_SECRET_KEY=
ATOM_AES_REQUEST_KEY=
ATOM_AES_REQUEST_IV=
ATOM_AES_RESPONSE_KEY=
ATOM_AES_RESPONSE_IV=
ATOM_PRODUCT=NSE
ATOM_CALLBACK_URL=http://localhost:4000/api/v1/payments/gateway/callback
ATOM_RETURN_URL=http://localhost:3000/payments/return
